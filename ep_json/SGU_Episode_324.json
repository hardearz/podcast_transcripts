{"id": "SGU_Episode_324", "title": "SGU Episode 324", "type": "structured", "description": "The Skeptic's Guide to the Universe, Episode 324 Transcript", "metadata": {"title": "SGU Episode 324", "date": "October 1 2024", "year": 2024, "month": 10, "day": 1, "rogues": ["Rebecca Watson", "Steven Novella", "Jay Novella", "Evan Bernstein", "Bob Novella"], "categories": [], "podcast_url": "https://www.theskepticsguide.org/podcasts/episode-324", "episode_number": 324}, "sections": [{"id": 0, "text": "You're listening to the Skeptics' Guide to the Universe, your escape to reality.\n", "title": "Introduction", "metadata": {"title": "Introduction"}, "sections": []}, {"id": 1, "text": "September 23 1846: Discovery of Neptune", "title": "This Day in Skepticism", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "This Day in Skepticism"}, "sections": []}, {"id": 2, "text": "", "title": "News Items", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "News Items"}, "sections": [{"id": 3, "text": "http://www.jpl.nasa.gov/news/news.cfm?release=2011-285", "title": "Grail Craft Launch", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://www.jpl.nasa.gov/news/news.cfm?release=2011-285"], "title": "Grail Craft Launch"}, "sections": []}, {"id": 4, "text": "http://m.apnews.com/ap/db_16053/contentdetail.htm?contentguid=oO5vCOhI http://www.scientificamerican.com/article.cfm?id=fossils-raise-questions-about-human-ancestry", "title": "A. sediba", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://m.apnews.com/ap/db_16053/contentdetail.htm?contentguid=oO5vCOhI", "http://www.scientificamerican.com/article.cfm?id=fossils-raise-questions-about-human-ancestry"], "title": "A. sediba"}, "sections": []}, {"id": 5, "text": "http://scienceblogs.com/gregladen/2011/09/coming_to_terms_with_the_femal.php", "title": "Adaptation and Orgasm", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://scienceblogs.com/gregladen/2011/09/coming_to_terms_with_the_femal.php"], "title": "Adaptation and Orgasm"}, "sections": []}]}, {"id": 6, "text": "http://siphonophores.org/SiphOrganization.php http://www.youtube.com/watch?v=KT1TSbarW1U", "title": "Special Report", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://siphonophores.org/SiphOrganization.php", "http://www.youtube.com/watch?v=KT1TSbarW1U"], "title": "Special Report"}, "sections": []}, {"id": 7, "text": "Top 10 Future TechnologiesThe Rogues Discuss their hopes for future technology\n", "title": "Top 10", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Top 10"}, "sections": []}, {"id": 8, "text": "Richard Saunders, Dr. Rachie Dunlop, and Jo Benhamu", "title": "Interview with Australian Skeptics", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Interview with Australian Skeptics"}, "sections": []}, {"id": 9, "text": "Item #1: A newly published review of the most frequently viewed YouTube videos claiming to depict a patient suffering from a movement disorder found that 2/3 of the videos actually showed individuals with a psychogenic disorder.\nItem #2: A new study shows that women's voices are higher during ovulation and harsher and more irregular during menstruation.\nItem #3: New evidence indicates that some small feathered dinosaurs survived for millions of years after the mass extinction that wiped out their cousins.\n", "title": "Science or Fiction", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Science or Fiction"}, "sections": []}, {"id": 10, "text": "", "title": "References", "metadata": {"title": "References"}, "sections": []}]}