{"id": "SGU_Episode_300", "title": "SGU Episode 300", "type": "structured", "description": "The Skeptic's Guide to the Universe, Episode 300 Transcript", "metadata": {"title": "SGU Episode 300", "date": "April 9 2024", "year": 2024, "month": 4, "day": 9, "rogues": ["Rebecca Watson", "Steven Novella", "Jay Novella", "Evan Bernstein", "Bob Novella"], "quotee_url": "http://en.wikipedia.org/wiki/Abraham_Lincoln", "quote": "\n 'You can't believe everything you read on the internet.' \n", "quotee": "\n Abraham Lincoln \n", "quotee_title": "", "categories": [], "podcast_url": "https://www.theskepticsguide.org/podcasts/episode-300", "episode_number": 300}, "sections": [{"id": 0, "text": "You're listening to the Skeptics' Guide to the Universe, your escape to reality.\n", "title": "Introduction", "metadata": {"title": "Introduction"}, "sections": []}, {"id": 1, "text": "", "title": "News Items", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "News Items"}, "sections": [{"id": 2, "text": "http://newsfeed.time.com/2011/04/07/archaeologists-find-worlds-first-gay-caveman-near-prague/", "title": "Gayveman", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://newsfeed.time.com/2011/04/07/archaeologists-find-worlds-first-gay-caveman-near-prague/"], "title": "Gayveman"}, "sections": []}, {"id": 3, "text": "http://astrobites.com/2011/02/03/avi-loeb-and-freeman-dyson-on-the-future-of-the-universe/", "title": "Cosmic Engineering", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://astrobites.com/2011/02/03/avi-loeb-and-freeman-dyson-on-the-future-of-the-universe/"], "title": "Cosmic Engineering"}, "sections": []}, {"id": 4, "text": "http://www.huffingtonpost.com/dana-ullman/homeopathy-for-radiation-poisioning_b_842664.html", "title": "Homeopathy for Radiation", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://www.huffingtonpost.com/dana-ullman/homeopathy-for-radiation-poisioning_b_842664.html"], "title": "Homeopathy for Radiation"}, "sections": []}, {"id": 5, "text": "http://www.monbiot.com/2011/04/04/evidence-meltdown/", "title": "Evidence and Radiation Risk", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "links": ["http://www.monbiot.com/2011/04/04/evidence-meltdown/"], "title": "Evidence and Radiation Risk"}, "sections": []}]}, {"id": 6, "text": "You Know you're a Skeptic If...The best submission from listeners.\n", "title": "You Know You're a Skeptic If", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "You Know You're a Skeptic If"}, "sections": []}, {"id": 7, "text": "Item #1: Astronomers have discovered a binary pair of white dwarf dead stars, that will one day merge into a new active star.\nItem #2: Scientists find that deep space travel is likely to cause vascular disease in astronauts.\nItem #3: Astronomers have recently discovered a near-earth asteroid in a rare horseshoe orbit \u2013 it reverses its course around the sun, traveling in a \u201cC\u201d or horseshoe path due to Earth\u2019s gravity.\n", "title": "Science or Fiction", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Science or Fiction"}, "sections": []}, {"id": 8, "text": "", "title": "Live Q&A", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Live Q&A"}, "sections": [{"id": 9, "text": "", "title": "Question #1 - Time Travel", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Question #1 - Time Travel"}, "sections": [{"id": 10, "text": "If the rogues traveled back in time, what could we change.", "metadata": {"speaker": "<unknown>"}}]}, {"id": 11, "text": "", "title": "Question #2 - Fecal Transplants", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Question #2 - Fecal Transplants"}, "sections": [{"id": 12, "text": "The science and fiction of fecal tranplants.", "metadata": {"speaker": "<unknown>"}}]}, {"id": 13, "text": "", "title": "Question #3 - Skeptical Obligations", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Question #3 - Skeptical Obligations"}, "sections": [{"id": 14, "text": "Are skeptics obligated morally to oppose irrationality.", "metadata": {"speaker": "<unknown>"}}]}]}, {"id": 15, "text": "", "title": "Skeptical Quote of the Week", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Skeptical Quote of the Week"}, "sections": [{"id": 16, "text": "'You can't believe everything you read on the internet.' - Abraham Lincoln", "metadata": {"speaker": "<unknown>"}}]}, {"id": 17, "text": "", "title": "References", "metadata": {"title": "References"}, "sections": []}]}