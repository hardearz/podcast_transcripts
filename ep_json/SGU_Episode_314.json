, "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Science or Fiction"}, "sections": []}, {"id": 26, "text": "", "title": "Skeptical Quote of the Week", "metadata": {"timestamp": "", "hour": 0, "minute": 0, "second": 0, "title": "Skeptical Quote of the Week"}, "sections": [{"id": 27, "text": "'Science is the best thing that humanity has ever come up with. And if it isn't, then science will fix it.' - Bill Nye", "metadata": {"speaker": "<unknown>"}}]}, {"id": 28, "text": "", "title": "References", "metadata": {"title": "References"}, "sections": []}]}