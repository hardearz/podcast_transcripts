ions/Follow-ups"}, "sections": [{"id": 17, "text": "", "title": "Correction #1: Cellulose vs. Collagen", "metadata": {"timestamp": "1:04:45", "hour": "1", "minute": "04", "second": "45", "title": "Correction #1: Cellulose vs. Collagen"}, "sections": []}, {"id": 18, "text": "", "title": "Correction #2: Analemma", "metadata": {"timestamp": "1:06:14", "hour": "1", "minute": "06", "second": "14", "title": "Correction #2: Analemma"}, "sections": []}]}, {"id": 19, "text": "Voice-over: It's time for Science or Fiction.\n", "title": "Science or Fiction", "metadata": {"timestamp": "1:15:13", "hour": "1", "minute": "15", "second": "13", "title": "Science or Fiction"}, "sections": [{"id": 20, "text": "", "title": "Bob's Response", "metadata": {"title": "Bob's Response"}, "sections": []}, {"id": 21, "text": "", "title": "Jay's Response", "metadata": {"title": "Jay's Response"}, "sections": []}, {"id": 22, "text": "", "title": "Evan's Response", "metadata": {"title": "Evan's Response"}, "sections": []}, {"id": 23, "text": "", "title": "Cara's Response", "metadata": {"title": "Cara's Response"}, "sections": []}, {"id": 24, "text": "", "title": "Steve Explains Item #3", "metadata": {"title": "Steve Explains Item #3"}, "sections": []}, {"id": 25, "text": "", "title": "Steve Explains Item #2", "metadata": {"title": "Steve Explains Item #2"}, "sections": []}, {"id": 26, "text": "", "title": "Steve Explains Item #1", "metadata": {"title": "Steve Explains Item #1"}, "sections": []}]}, {"id": 27, "text": "", "title": "Skeptical Quote of the Week", "metadata": {"timestamp": "1:27:45", "hour": "1", "minute": "27", "second": "45", "title": "Skeptical Quote of the Week"}, "sections": [{"id": 28, "text": "It is absolutely essential that one should be neutral and not fall in love with the hypothesis.\u2013 David Douglass, American physicist", "metadata": {"speaker": "<unknown>"}}]}, {"id": 29, "text": "", "title": "Signoff", "metadata": {"title": "Signoff"}, "sections": [{"id": 30, "text": "\